# ==============================================================================
# DukaanMitra MitraOS — Environment Configuration Template (mvp1-aafa3)
# ==============================================================================
# Copy to .env.local (never commit real credentials).
# All client-exposed variables MUST start with VITE_.
# Never place private secrets (Gemini API key, Razorpay secret, Firebase service
# account credentials) in any VITE_* variable.

# --- Firebase Client Web Config (Project: mvp1-aafa3) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mvp1-aafa3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mvp1-aafa3
VITE_FIREBASE_STORAGE_BUCKET=mvp1-aafa3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional:
VITE_FIREBASE_MEASUREMENT_ID=

# --- Optional Customer Phone Doc ID Normalization Strategy ---
# Allowed values: digits10 (default) | e164_in | raw_trimmed
VITE_CUSTOMER_PHONE_ID_FORMAT=digits10

# --- Optional Authenticated Backend Service Boundary URLs ---
VITE_ORDERS_API_BASE_URL=
VITE_AI_PROXY_BASE_URL=
VITE_CORE_ENGINE_API_BASE_URL=

# --- Server-Side Only Secrets (Node / Express / Next.js / Python — NEVER VITE_*) ---
FIREBASE_PROJECT_ID=mvp1-aafa3
FIREBASE_SERVICE_ACCOUNT_KEY=
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOWED_ORIGINS=https://dukaanmitra.in,https://www.dukaanmitra.in,http://localhost:3000
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_SECRET=
CRON_SECRET=
INGEST_API_SECRET=
MCP_GATEWAY_SECRET=
GATEWAY_API_SECRET=
CORE_ENGINE_INTERNAL_SECRET=
PORT=3000
