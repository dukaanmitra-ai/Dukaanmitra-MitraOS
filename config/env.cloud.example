# DukaanMitra Cloud-Native Environment Configuration
# All services cloud-hosted - no local dependencies

# ============================================================================
# Database Configuration (Cloud Only)
# ============================================================================
DATABASE_URL=postgresql://user:password@host:5432/dukaanmitra
DUKAANMITRA_DB=/app/data/dukaanmitra_shared.db  # Fallback for Render

# ============================================================================
# AI/ML Configuration (Cloud APIs Only)
# ============================================================================
OPENAI_API_KEY=sk-xxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxx
AI_MODEL_DEFAULT=gpt-4
AI_MODEL_FAST=gpt-3.5-turbo
AI_MODEL_LONG=claude-3-opus

# ============================================================================
# MCP Configuration (Cloud-Native)
# ============================================================================
MCP_SERVER_OPENAI=https://api.openai.com/v1
MCP_SERVER_ANTHROPIC=https://api.anthropic.com/v1
MCP_SERVER_CORE_API=https://api.dukaanmitra.in
MCP_SERVER_AI_BRAIN=https://ai.dukaanmitra.in

# ============================================================================
# WhatsApp Configuration (Cloud API Only)
# ============================================================================
WHATSAPP_VERIFY_TOKEN=dukaanmitra_verify_token_prod
WHATSAPP_APP_SECRET=xxxxx
WHATSAPP_ACCESS_TOKEN=xxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxx

# ============================================================================
# Storage Configuration (Cloud Only)
# ============================================================================
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dukaanmitra-prod

# ============================================================================
# Cache Configuration (Cloud Redis)
# ============================================================================
REDIS_URL=redis://default:xxxxx@dukaanmitra-redis.render.com:6379
REDIS_PASSWORD=xxxxx

# ============================================================================
# Security Configuration
# ============================================================================
APP_SECRET=xxxxx
JWT_SECRET=xxxxx
ENCRYPTION_KEY=xxxxx

# ============================================================================
# Domain Configuration
# ============================================================================
BASE_DOMAIN=dukaanmitra.in
API_DOMAIN=api.dukaanmitra.in
APP_DOMAIN=app.dukaanmitra.in
PORTAL_DOMAIN=portal.dukaanmitra.in

# ============================================================================
# Monitoring & Analytics (Cloud Only)
# ============================================================================
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
POSTHOG_API_KEY=xxxxx
POSTHOG_HOST=https://app.posthog.com

# ============================================================================
# Deployment Configuration
# ============================================================================
NODE_ENV=production
PYTHONUNBUFFERED=1
LOG_LEVEL=info
